# PostgreSQL
POSTGRES_USER=agents
POSTGRES_PASSWORD=agents
POSTGRES_DB=agents
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Grafana
GRAFANA_PASSWORD=admin

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Exchange keys (NEVER commit real values)
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# LLM
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Safety defaults: live execution stays disabled until explicitly enabled.
LIVE_TRADING_ENABLED=false
LIVE_TRADING_CONFIRMATION=
MAX_ORDER_NOTIONAL=1000
SECRETS_ROTATION_DAYS=90
